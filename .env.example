# Copy to .env and change every password before running anywhere non-local.
#   cp .env.example .env

# --- PostgreSQL ---
PG_DB=agristream
PG_ADMIN_USER=agri_admin
PG_ADMIN_PASSWORD=change_me_admin

# Least-privilege application roles (created by postgres/init/02-roles.sh)
FLINK_DB_USER=flink_writer
FLINK_DB_PASSWORD=change_me_flink
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change_me_grafana
RETENTION_DB_USER=retention_job
RETENTION_DB_PASSWORD=change_me_retention

# Days of 1-minute aggregates to keep
RETENTION_DAYS=30

# --- Producer (sensor simulator) ---
RATE_PER_SEC=50
NUM_SENSORS=30
NUM_FIELDS=5
LATE_RATIO=0.03
MAX_LATENESS_MS=8000
MALFORMED_RATIO=0.005

# --- Flink job ---
WATERMARK_DELAY_SECONDS=10

# --- Grafana (profile: monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
